<Window x:Class="Sonora.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sonora.Views"
        Title="Sonora" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="Height" Width="340"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Size.Text.Body}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MiniPlayPause" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="Lecture" />
            <Setter Property="Command" Value="{Binding TogglePlayCommand}" />
            <Setter Property="v:Motion.PulseOnChange" Value="{Binding Player.IsPlaying}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="ToolTip" Value="Pause" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10" Margin="12"
            MouseLeftButtonDown="Drag_Start">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="52" Height="52">
                    <Border CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" FontSize="18" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border CornerRadius="{DynamicResource Radius.Art}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Player.Current.AlbumRef.ArtPath, Converter={StaticResource Art}, ConverterParameter=112}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Player.Current.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Player.Current.Artist}" FontSize="{DynamicResource Size.Text.Small}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource IconButton}" Content="&#xE740;" FontSize="12" Width="26" Height="26"
                        VerticalAlignment="Top" Click="Restore_Click" ToolTip="{loc:T mini.back_to_the_main_window_esc}" />
            </Grid>

            <Slider Style="{DynamicResource ThinSlider}" Minimum="0" Maximum="{Binding Player.SliderMax}" Margin="0,8,0,0"
                    Value="{Binding Player.SeekValue, Mode=TwoWay}"
                    Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="14" Width="30" Height="30"
                        Command="{Binding ToggleShuffleCommand}" ToolTip="{loc:T common.shuffle}" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE892;" FontSize="16" Width="30" Height="30"
                        Command="{Binding PreviousCommand}" ToolTip="{loc:T common.previous}" />
                <Button Style="{StaticResource MiniPlayPause}" FontSize="18" Width="34" Height="34" Margin="4,0" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE893;" FontSize="16" Width="30" Height="30"
                        Command="{Binding NextCommand}" ToolTip="{loc:T common.next}" />
                <Button Style="{DynamicResource IconButton}" Content="{Binding Player.RepeatGlyph}" FontSize="14" Width="30" Height="30"
                        Command="{Binding CycleRepeatCommand}" ToolTip="{loc:T common.repeat}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
