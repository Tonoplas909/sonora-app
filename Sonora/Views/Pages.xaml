<ResourceDictionary x:Class="Sonora.Views.Pages"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Sonora.ViewModels"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- Page templates. The centre of the window shows CurrentPage through these implicit DataTemplates. -->

    <!-- ============ Home ============ -->

    <DataTemplate x:Key="ShelfHeader" DataType="{x:Type v:HomeSectionView}">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkText}" Content="{loc:T pages.show_all}" Foreground="{DynamicResource Brush.TextSecondary}"
                    FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding ShowAll}"
                    Visibility="{Binding HasShowAll, Converter={StaticResource BoolToVis}}" />
            <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{Binding Title}" />
        </DockPanel>
    </DataTemplate>

    <!-- Shelves clip their overflowing cards on the right; the clip starts 6 px higher than the cards (padding offset by
         a negative margin, so nothing moves) so a card lifted by the pointer is not cut at the top. -->
    <DataTemplate x:Key="AlbumShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,-6,0,0" Padding="0,6,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ArtistShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,-6,0,0" Padding="0,6,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="PlaylistShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,-6,0,0" Padding="0,6,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource PlaylistCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <v:HomeSectionTemplateSelector x:Key="ShelfSelector" Albums="{StaticResource AlbumShelf}"
                                   Artists="{StaticResource ArtistShelf}" Playlists="{StaticResource PlaylistShelf}" />

    <DataTemplate DataType="{x:Type vm:HomePage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{Binding Greeting}" Style="{DynamicResource PageTitleBox}" />

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="0,32,0,0">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Left" />
                    <ContentControl Content="{loc:T pages.your_library_is_empty}" Style="{DynamicResource SectionTitleBox}" Margin="0,16,0,6" />
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="{loc:T pages.sonora_plays_your_local_audio_files}" />
                    <TextBlock Text="{loc:T pages.scanning}" Foreground="{DynamicResource Brush.Accent}" Margin="0,12,0,0"
                               Visibility="{Binding Main.IsScanning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{DynamicResource PillButton}" Content="{loc:T pages.add_a_folder}" Margin="0,20,0,0" Command="{Binding Main.AddFolderCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Sections}" ItemTemplateSelector="{StaticResource ShelfSelector}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Track list page (album, playlist, liked, genre, all) ============ -->

    <DataTemplate DataType="{x:Type vm:TracksPage}">
        <Grid Loaded="TracksHeader_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Expanded header: cover, kind/title/subtitle. Collapses to nothing (LayoutTransform, not just
                 Opacity, so the row's height actually shrinks) once the list below has scrolled a little. -->
            <Border x:Name="HeaderBand" Style="{DynamicResource HeaderBandStyle}">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="HeaderScale" ScaleY="1" />
                </Border.LayoutTransform>
                <DockPanel>
                    <Grid Width="168" Height="168" DockPanel.Dock="Left" Style="{DynamicResource HeaderCoverStyle}">
                        <Border x:Name="Ph" CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                            <TextBlock x:Name="PhGlyph" Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Border>
                        <Border CornerRadius="{DynamicResource Radius.Art}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding ArtSource.ArtPath, Converter={StaticResource Art}, ConverterParameter=340}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding KindLabel}" FontSize="{DynamicResource Size.Text.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding Header}" Style="{DynamicResource HeaderTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Expanded play/shuffle/more row: same collapse treatment as the header band above. -->
            <StackPanel x:Name="BigButtonsRow" Grid.Row="1" Orientation="Horizontal" Margin="24,8,24,4">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="ButtonsScale" ScaleY="1" />
                </StackPanel.LayoutTransform>
                <Button Style="{DynamicResource BigPlay}" Command="{Binding PlayCommand}" ToolTip="{loc:T pages.play}" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="22" Width="48" Height="48" Margin="16,0,0,0"
                        Command="{Binding ShuffleCommand}" ToolTip="{loc:T common.shuffle}" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE712;" FontSize="20" Width="48" Height="48"
                        Click="PageMore_Click" ToolTip="{loc:T pages.more_options}" />
            </StackPanel>

            <!-- Collapsed compact bar: hidden (ScaleY 0) until the header band above collapses, then this one
                 line — title plus small play/shuffle buttons — takes over in the same spot. -->
            <Grid x:Name="CompactBar" Grid.Row="2" Margin="24,2,24,2">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="CompactScale" ScaleY="0" />
                </Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Header}" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Section}"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource IconButton}" Content="&#xE768;" FontSize="16" Width="32" Height="32"
                            Command="{Binding PlayCommand}" ToolTip="{loc:T pages.play}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="16" Width="32" Height="32" Margin="8,0,0,0"
                            Command="{Binding ShuffleCommand}" ToolTip="{loc:T common.shuffle}" />
                </StackPanel>
            </Grid>

            <!-- Filter and sort. Both run on the tracks already loaded, so they behave the same for a local
                 album and for a Spotify playlist; while either is active the list plays what it shows. -->
            <Grid Grid.Row="3" Margin="24,4,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Left" Width="260">
                    <TextBox x:Name="ListFilterBox" Style="{DynamicResource SearchBox}" Height="34" FontSize="{DynamicResource Size.Text.Small}"
                             Tag="{loc:T pages.filter_this_list}"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="12" Width="24" Height="24"
                            HorizontalAlignment="Right" Margin="0,0,6,0" Command="{Binding ClearFilterCommand}" ToolTip="{loc:T pages.clear_the_filter}"
                            Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkText}" Content="{Binding SelectedSort.Label}" Click="Sort_Click"
                            Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                            FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{loc:T pages.sort_the_list}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8CB;" FontSize="16" Width="30" Height="30"
                            Margin="4,0,0,0" Click="Sort_Click" ToolTip="{loc:T pages.sort_the_list}" />
                    <Button Style="{DynamicResource IconButton}" Content="{Binding SortDirectionGlyph}" FontSize="14" Width="30" Height="30"
                            Command="{Binding ToggleSortDirectionCommand}" ToolTip="{loc:T pages.reverse_the_sort_order}"
                            Visibility="{Binding IsSorted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <ContentPresenter Grid.Row="4" Margin="16,8,24,0" ContentTemplate="{DynamicResource TrackHeaderTemplate}" />

            <ListBox x:Name="TrackListBox" Grid.Row="5" Style="{StaticResource TrackList}" ItemsSource="{Binding Rows}" Margin="16,8,8,0" />
            <TextBlock Grid.Row="5" Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="24,24,24,0"
                       TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="5" Text="{loc:T pages.loading}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="24,24,24,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                <Setter TargetName="Ph" Property="Background" Value="{DynamicResource Brush.SpecialGradient}" />
                <Setter TargetName="PhGlyph" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Artist ============ -->

    <DataTemplate DataType="{x:Type vm:ArtistPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource HeaderBandStyle}">
                    <DockPanel>
                        <Grid Width="168" Height="168" DockPanel.Dock="Left">
                            <Border CornerRadius="84" Background="{DynamicResource Brush.Hover}">
                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE77B;" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" />
                            </Border>
                            <Border CornerRadius="84">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Artist.ArtPath, Converter={StaticResource Art}, ConverterParameter=340}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="{loc:T pages.artist}" FontSize="{DynamicResource Size.Text.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Artist.Name}" Style="{DynamicResource HeaderTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Margin="24,16,24,32">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource BigPlay}" Command="{Binding PlayCommand}" ToolTip="{loc:T pages.play}" />
                        <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="22" Width="48" Height="48" Margin="16,0,0,0"
                                Command="{Binding ShuffleCommand}" ToolTip="{loc:T common.shuffle}" />
                        <Button Style="{DynamicResource IconButton}" Content="&#xE712;" FontSize="20" Width="48" Height="48"
                                Click="PageMore_Click" ToolTip="{loc:T pages.more_options}" />
                    </StackPanel>
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.tracks}" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding TopRows}" Margin="-8,0,0,0" />
                    <Button Style="{StaticResource LinkText}" Content="{Binding ShowMoreText}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"
                            Margin="0,12,0,0" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.discography}" />
                    <TextBlock Text="{loc:T pages.loading}" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Search ============ -->

    <DataTemplate DataType="{x:Type vm:SearchPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <!-- Type filters: they only hide sections of the results already fetched, so switching is instant. -->
                <WrapPanel Margin="0,4,0,4" Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T pages.all}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T pages.tracks}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=tracks}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T common.artists}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=artists}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T common.albums}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=albums}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T common.playlists}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=playlists}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="{loc:T pages.podcasts}" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=shows}" />
                </WrapPanel>

                <StackPanel Visibility="{Binding HasQuery, Converter={StaticResource InvBoolToVis}}">
                    <!-- Recent searches, newest first. Kept in state.json; can be turned off in the settings. -->
                    <StackPanel Visibility="{Binding HasRecentSearches, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkText}" Content="{loc:T pages.clear}" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                    Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" Command="{Binding ClearRecentCommand}" />
                            <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.recent_searches}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentSearches}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource PillOutline}" Content="{Binding}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{loc:T pages.tip_search_accepts_spotify_s}" />
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.browse_by_genre}" />
                    <ItemsControl ItemsSource="{Binding Genres}" ItemsPanel="{DynamicResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Cursor="Hand" Focusable="False" Margin="0,0,16,16"
                                        Command="{Binding DataContext.OpenGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Genre}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Width="196" Height="108" CornerRadius="{DynamicResource Radius.Panel}" Background="{Binding Brush}" ClipToBounds="True">
                                                <TextBlock Text="{Binding Genre.Name}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           Margin="16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:T pages.no_genre_in_your_files_metadata}" Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding NoGenres, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ContentControl Content="{loc:T pages.no_results}" Style="{DynamicResource SectionTitleBox}" Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}" />

                <!-- Top result: Sonora's own pick, since Spotify computes its own server-side and keeps it. -->
                <StackPanel Visibility="{Binding HasTopResult, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.top_result}" />
                    <Button Style="{StaticResource CardButton}" Command="{Binding TopResult.Open}" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Border Width="380" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.SurfaceAlt}" Padding="18">
                            <DockPanel>
                                <Grid Width="88" Height="88" DockPanel.Dock="Left">
                                    <Border Background="{DynamicResource Brush.Hover}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Art}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopResult.IsRound}" Value="True">
                                                        <Setter Property="CornerRadius" Value="44" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Art}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopResult.IsRound}" Value="True">
                                                        <Setter Property="CornerRadius" Value="44" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding TopResult.ArtSource.ArtPath, Converter={StaticResource Art}, ConverterParameter=180}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TopResult.Name}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font.Display}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TopResult.Kind}" FontSize="{DynamicResource Size.Text.Small}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.tracks}" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding Tracks}" Margin="-8,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasLocalTracks, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.in_your_local_files}" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding LocalTracks}" Margin="-8,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasPlaylists, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T common.playlists}" />
                    <ItemsControl ItemsSource="{Binding Playlists}" ItemTemplate="{DynamicResource PlaylistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasArtists, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T common.artists}" />
                    <ItemsControl ItemsSource="{Binding Artists}" ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasAlbums, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T common.albums}" />
                    <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasShows, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.podcasts}" />
                    <ItemsControl ItemsSource="{Binding Shows}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.episodes}" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding Episodes}" Margin="-8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Discover ============ -->

    <DataTemplate DataType="{x:Type vm:DiscoverPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{loc:T common.discover}" Style="{DynamicResource PageTitleBox}" />
                <TextBlock Text="{loc:T pages.connect_your_spotify_account_to_fill}" Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="0,0,0,16" TextWrapping="Wrap" Visibility="{Binding NeedsSpotify, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{loc:T pages.all_the_discover_sections_are_turned}" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Open}" Margin="12,0,0,16">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Width="240" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.SurfaceAlt}" Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="26"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Display}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,10,0,4" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="{DynamicResource Size.Text.Small}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TopsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{loc:T pages.your_tops}" Style="{DynamicResource PageTitleBox}" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="{loc:T pages.4_weeks}" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=short_term}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="{loc:T pages.6_months}" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=medium_term}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="{loc:T pages.all_time}" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=long_term}" />
                </WrapPanel>
                <TextBlock Text="{loc:T pages.loading}" Foreground="{DynamicResource Brush.TextSecondary}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
