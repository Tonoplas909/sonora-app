<ResourceDictionary x:Class="Sonora.Views.Pages"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Sonora.ViewModels"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- Page templates. The centre of the window shows CurrentPage through these implicit DataTemplates. -->

    <!-- ============ Home ============ -->

    <DataTemplate x:Key="ShelfHeader" DataType="{x:Type v:HomeSectionView}">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkText}" Content="Tout afficher" Foreground="{DynamicResource Brush.TextSecondary}"
                    FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding ShowAll}"
                    Visibility="{Binding HasShowAll, Converter={StaticResource BoolToVis}}" />
            <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{Binding Title}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="AlbumShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,0,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ArtistShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,0,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="PlaylistShelf" DataType="{x:Type v:HomeSectionView}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShelfHeader}" />
            <Border ClipToBounds="True" Margin="-12,0,0,0" v:LazyShelf.Enabled="True">
                <ItemsControl ItemTemplate="{DynamicResource PlaylistCard}" ItemsPanel="{DynamicResource ShelfPanelTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <v:HomeSectionTemplateSelector x:Key="ShelfSelector" Albums="{StaticResource AlbumShelf}"
                                   Artists="{StaticResource ArtistShelf}" Playlists="{StaticResource PlaylistShelf}" />

    <DataTemplate DataType="{x:Type vm:HomePage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{Binding Greeting}" Style="{DynamicResource PageTitleBox}" />

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="0,32,0,0">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Left" />
                    <ContentControl Content="Votre bibliothèque est vide" Style="{DynamicResource SectionTitleBox}" Margin="0,16,0,6" />
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Sonora lit vos fichiers audio locaux (MP3, FLAC, AAC/M4A, WAV, OGG, Opus, WMA) et votre compte Spotify. Ajoutez un dossier de musique pour commencer." />
                    <TextBlock Text="Analyse en cours…" Foreground="{DynamicResource Brush.Accent}" Margin="0,12,0,0"
                               Visibility="{Binding Main.IsScanning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{DynamicResource PillButton}" Content="Ajouter un dossier" Margin="0,20,0,0" Command="{Binding Main.AddFolderCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Sections}" ItemTemplateSelector="{StaticResource ShelfSelector}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Track list page (album, playlist, liked, genre, all) ============ -->

    <DataTemplate DataType="{x:Type vm:TracksPage}">
        <Grid Loaded="TracksHeader_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Expanded header: cover, kind/title/subtitle. Collapses to nothing (LayoutTransform, not just
                 Opacity, so the row's height actually shrinks) once the list below has scrolled a little. -->
            <Border x:Name="HeaderBand" Style="{DynamicResource HeaderBandStyle}">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="HeaderScale" ScaleY="1" />
                </Border.LayoutTransform>
                <DockPanel>
                    <Grid Width="168" Height="168" DockPanel.Dock="Left" Style="{DynamicResource HeaderCoverStyle}">
                        <Border x:Name="Ph" CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                            <TextBlock x:Name="PhGlyph" Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Border>
                        <Border CornerRadius="{DynamicResource Radius.Art}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding ArtSource.ArtPath, Converter={StaticResource Art}, ConverterParameter=340}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Kind}" FontSize="{DynamicResource Size.Text.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding Header}" Style="{DynamicResource HeaderTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Expanded play/shuffle/more row: same collapse treatment as the header band above. -->
            <StackPanel x:Name="BigButtonsRow" Grid.Row="1" Orientation="Horizontal" Margin="24,8,24,4">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="ButtonsScale" ScaleY="1" />
                </StackPanel.LayoutTransform>
                <Button Style="{DynamicResource BigPlay}" Command="{Binding PlayCommand}" ToolTip="Lecture" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="22" Width="48" Height="48" Margin="16,0,0,0"
                        Command="{Binding ShuffleCommand}" ToolTip="Lecture aléatoire" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE712;" FontSize="20" Width="48" Height="48"
                        Click="PageMore_Click" ToolTip="Plus d'options" />
            </StackPanel>

            <!-- Collapsed compact bar: hidden (ScaleY 0) until the header band above collapses, then this one
                 line — title plus small play/shuffle buttons — takes over in the same spot. -->
            <Grid x:Name="CompactBar" Grid.Row="2" Margin="24,2,24,2">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="CompactScale" ScaleY="0" />
                </Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Header}" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Section}"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource IconButton}" Content="&#xE768;" FontSize="16" Width="32" Height="32"
                            Command="{Binding PlayCommand}" ToolTip="Lecture" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="16" Width="32" Height="32" Margin="8,0,0,0"
                            Command="{Binding ShuffleCommand}" ToolTip="Lecture aléatoire" />
                </StackPanel>
            </Grid>

            <!-- Filter and sort. Both run on the tracks already loaded, so they behave the same for a local
                 album and for a Spotify playlist; while either is active the list plays what it shows. -->
            <Grid Grid.Row="3" Margin="24,4,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Left" Width="260">
                    <TextBox x:Name="ListFilterBox" Style="{DynamicResource SearchBox}" Height="34" FontSize="{DynamicResource Size.Text.Small}"
                             Tag="Filtrer dans cette liste"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="12" Width="24" Height="24"
                            HorizontalAlignment="Right" Margin="0,0,6,0" Command="{Binding ClearFilterCommand}" ToolTip="Effacer le filtre"
                            Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkText}" Content="{Binding SelectedSort.Label}" Click="Sort_Click"
                            Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                            FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Trier la liste" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8CB;" FontSize="16" Width="30" Height="30"
                            Margin="4,0,0,0" Click="Sort_Click" ToolTip="Trier la liste" />
                    <Button Style="{DynamicResource IconButton}" Content="{Binding SortDirectionGlyph}" FontSize="14" Width="30" Height="30"
                            Command="{Binding ToggleSortDirectionCommand}" ToolTip="Inverser le sens du tri"
                            Visibility="{Binding IsSorted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <ContentPresenter Grid.Row="4" Margin="16,8,24,0" ContentTemplate="{DynamicResource TrackHeaderTemplate}" />

            <ListBox x:Name="TrackListBox" Grid.Row="5" Style="{StaticResource TrackList}" ItemsSource="{Binding Rows}" Margin="16,8,8,0" />
            <TextBlock Grid.Row="5" Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="24,24,24,0"
                       TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="5" Text="Chargement…" Foreground="{DynamicResource Brush.TextSecondary}" Margin="24,24,24,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                <Setter TargetName="Ph" Property="Background" Value="{DynamicResource Brush.SpecialGradient}" />
                <Setter TargetName="PhGlyph" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Artist ============ -->

    <DataTemplate DataType="{x:Type vm:ArtistPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource HeaderBandStyle}">
                    <DockPanel>
                        <Grid Width="168" Height="168" DockPanel.Dock="Left">
                            <Border CornerRadius="84" Background="{DynamicResource Brush.Hover}">
                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE77B;" FontSize="56" Foreground="{DynamicResource Brush.TextMuted}" />
                            </Border>
                            <Border CornerRadius="84">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Artist.ArtPath, Converter={StaticResource Art}, ConverterParameter=340}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="Artiste" FontSize="{DynamicResource Size.Text.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Artist.Name}" Style="{DynamicResource HeaderTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Margin="24,16,24,32">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource BigPlay}" Command="{Binding PlayCommand}" ToolTip="Lecture" />
                        <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="22" Width="48" Height="48" Margin="16,0,0,0"
                                Command="{Binding ShuffleCommand}" ToolTip="Lecture aléatoire" />
                        <Button Style="{DynamicResource IconButton}" Content="&#xE712;" FontSize="20" Width="48" Height="48"
                                Click="PageMore_Click" ToolTip="Plus d'options" />
                    </StackPanel>
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Titres" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding TopRows}" Margin="-8,0,0,0" />
                    <Button Style="{StaticResource LinkText}" Content="{Binding ShowMoreText}" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"
                            Margin="0,12,0,0" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Discographie" />
                    <TextBlock Text="Chargement…" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Search ============ -->

    <DataTemplate DataType="{x:Type vm:SearchPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <!-- Type filters: they only hide sections of the results already fetched, so switching is instant. -->
                <WrapPanel Margin="0,4,0,4" Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Tout" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Titres" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=tracks}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Artistes" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=artists}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Albums" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=albums}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Playlists" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=playlists}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="SearchType" Content="Podcasts" Margin="0,0,8,4"
                                 IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=shows}" />
                </WrapPanel>

                <StackPanel Visibility="{Binding HasQuery, Converter={StaticResource InvBoolToVis}}">
                    <!-- Recent searches, newest first. Kept in state.json; can be turned off in the settings. -->
                    <StackPanel Visibility="{Binding HasRecentSearches, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkText}" Content="Effacer" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                    Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" Command="{Binding ClearRecentCommand}" />
                            <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Recherches récentes" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentSearches}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource PillOutline}" Content="{Binding}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Astuce : la recherche accepte les opérateurs de Spotify — artist:, album:, track:, year:2020-2024, genre:, label:, isrc:." />
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Parcourir par genre" />
                    <ItemsControl ItemsSource="{Binding Genres}" ItemsPanel="{DynamicResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Cursor="Hand" Focusable="False" Margin="0,0,16,16"
                                        Command="{Binding DataContext.OpenGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Genre}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Width="196" Height="108" CornerRadius="{DynamicResource Radius.Panel}" Background="{Binding Brush}" ClipToBounds="True">
                                                <TextBlock Text="{Binding Genre.Name}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           Margin="16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun genre dans les métadonnées de vos fichiers." Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding NoGenres, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ContentControl Content="Aucun résultat" Style="{DynamicResource SectionTitleBox}" Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}" />

                <!-- Top result: Sonora's own pick, since Spotify computes its own server-side and keeps it. -->
                <StackPanel Visibility="{Binding HasTopResult, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Résultat principal" />
                    <Button Style="{StaticResource CardButton}" Command="{Binding TopResult.Open}" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Border Width="380" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.SurfaceAlt}" Padding="18">
                            <DockPanel>
                                <Grid Width="88" Height="88" DockPanel.Dock="Left">
                                    <Border Background="{DynamicResource Brush.Hover}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Art}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopResult.IsRound}" Value="True">
                                                        <Setter Property="CornerRadius" Value="44" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Art}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopResult.IsRound}" Value="True">
                                                        <Setter Property="CornerRadius" Value="44" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding TopResult.ArtSource.ArtPath, Converter={StaticResource Art}, ConverterParameter=180}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TopResult.Name}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font.Display}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TopResult.Kind}" FontSize="{DynamicResource Size.Text.Small}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Titres" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding Tracks}" Margin="-8,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasLocalTracks, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Dans vos fichiers locaux" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding LocalTracks}" Margin="-8,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasPlaylists, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Playlists" />
                    <ItemsControl ItemsSource="{Binding Playlists}" ItemTemplate="{DynamicResource PlaylistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasArtists, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Artistes" />
                    <ItemsControl ItemsSource="{Binding Artists}" ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasAlbums, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Albums" />
                    <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasShows, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Podcasts" />
                    <ItemsControl ItemsSource="{Binding Shows}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Épisodes" />
                    <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding Episodes}" Margin="-8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Discover ============ -->

    <DataTemplate DataType="{x:Type vm:DiscoverPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Découvrir" Style="{DynamicResource PageTitleBox}" />
                <TextBlock Text="Connectez votre compte Spotify pour remplir ces pages." Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="0,0,0,16" TextWrapping="Wrap" Visibility="{Binding NeedsSpotify, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Toutes les sections de Découvrir sont désactivées dans les paramètres." Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Command="{Binding Open}" Margin="12,0,0,16">
                                <Border Width="240" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.SurfaceAlt}" Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="26"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Size.Text.Section}" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Display}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,10,0,4" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="{DynamicResource Size.Text.Small}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TopsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Vos tops" Style="{DynamicResource PageTitleBox}" />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="4 semaines" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=short_term}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="6 mois" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=medium_term}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="TopRange" Content="Depuis toujours" Margin="0,0,8,4"
                                 IsChecked="{Binding Range, Converter={StaticResource Eq}, ConverterParameter=long_term}" />
                </WrapPanel>
                <TextBlock Text="Chargement…" Foreground="{DynamicResource Brush.TextSecondary}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Vos titres" />
                <Button Style="{DynamicResource BigPlay}" Command="{Binding PlayCommand}" ToolTip="Lecture" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <ListBox Style="{StaticResource TrackListStatic}" ItemsSource="{Binding Tracks}" Margin="-8,0,0,0" />
                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Vos artistes" />
                <ItemsControl ItemsSource="{Binding Artists}" ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StatsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Vos statistiques" Style="{DynamicResource PageTitleBox}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"
                           Text="Compté par Sonora sur cette machine, à partir de vos écoutes réelles. Spotify n'ouvre ces chiffres à aucune application tierce." />
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton Style="{DynamicResource Chip}" GroupName="StatsPeriod" Content="7 jours" Margin="0,0,8,4"
                                 IsChecked="{Binding Days, Converter={StaticResource Eq}, ConverterParameter=7}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="StatsPeriod" Content="30 jours" Margin="0,0,8,4"
                                 IsChecked="{Binding Days, Converter={StaticResource Eq}, ConverterParameter=30}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="StatsPeriod" Content="12 mois" Margin="0,0,8,4"
                                 IsChecked="{Binding Days, Converter={StaticResource Eq}, ConverterParameter=365}" />
                    <RadioButton Style="{DynamicResource Chip}" GroupName="StatsPeriod" Content="Depuis toujours" Margin="0,0,8,4"
                                 IsChecked="{Binding Days, Converter={StaticResource Eq}, ConverterParameter=0}" />
                </WrapPanel>
                <TextBlock Text="{Binding Totals}" FontWeight="SemiBold" FontSize="{DynamicResource Size.Text.Large}"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Quand vous écoutez" />
                    <!-- One bar per hour of the day, each as tall as its share of the busiest hour. -->
                    <ItemsControl ItemsSource="{Binding Hours}" Height="120">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="1,0" ToolTip="{Binding Plays}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                                            Height="{Binding Share, Converter={StaticResource BarHeight}, ConverterParameter=96}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Vos titres les plus écoutés" />
                    <ItemsControl ItemsSource="{Binding TopTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Plays}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                                                   FontSize="{DynamicResource Size.Text.Small}" />
                                        <TextBlock Text="{Binding Listened}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.TextMuted}" FontFamily="{DynamicResource Font.Numbers}"
                                                   FontSize="{DynamicResource Size.Text.Small}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Size.Text.Small}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Vos artistes les plus écoutés" />
                    <ItemsControl ItemsSource="{Binding TopArtists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Plays}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                                               FontSize="{DynamicResource Size.Text.Small}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Style="{DynamicResource PillOutline}" Content="Effacer l'historique local" Margin="0,24,0,0"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ArtistGridPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{Binding Title}" Style="{DynamicResource PageTitleBox}" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Recherche des artistes proches…" Foreground="{DynamicResource Brush.TextSecondary}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AlbumGridPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="{Binding Title}" Style="{DynamicResource PageTitleBox}" />
                <TextBlock Text="Chargement…" Foreground="{DynamicResource Brush.TextSecondary}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Grids ============ -->

    <DataTemplate DataType="{x:Type vm:AlbumsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Albums" Style="{DynamicResource PageTitleBox}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource AlbumCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ArtistsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Artistes" Style="{DynamicResource PageTitleBox}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource ArtistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlaylistsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,32">
                <ContentControl Content="Playlists" Style="{DynamicResource PageTitleBox}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource PlaylistCard}" ItemsPanel="{DynamicResource WrapPanelTemplate}" Margin="-12,0,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Settings ============ -->

    <DataTemplate DataType="{x:Type vm:SettingsPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,32" MaxWidth="820" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
                <ContentControl Content="Paramètres" Style="{DynamicResource PageTitleBox}" />

                <Button Style="{DynamicResource NavItem}" Command="{Binding Main.OpenAppearanceCommand}" Padding="16,14" HorizontalAlignment="Stretch"
                        Background="{DynamicResource Brush.SurfaceAlt}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel>
                            <TextBlock Text="Apparence" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Thèmes, couleurs, typo, disposition des panneaux et contenu affiché" FontSize="{DynamicResource Size.Text.Small}" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Compte Spotify" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding Main.Spotify.Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding Main.Spotify.IsConnected, Converter={StaticResource InvBoolToVis}}" Margin="0,12,0,0">
                            <TextBlock Text="Client ID" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Main.SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Adresse de redirection" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE8C8;" ToolTip="Copier" Command="{Binding Main.CopyRedirectUriCommand}" />
                                <TextBox Text="{Binding Main.RedirectUri, Mode=OneWay}" IsReadOnly="True" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{DynamicResource AccentPill}" Content="Se connecter avec Spotify" Command="{Binding Main.SpotifyLoginCommand}" />
                                <Button Style="{DynamicResource PillOutline}" Content="Tableau de bord développeur" Margin="12,0,0,0" Command="{Binding Main.OpenDeveloperDashboardCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Main.Spotify.IsConnected, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="Actualiser la bibliothèque" Command="{Binding Main.SpotifyRefreshCommand}" />
                            <Button Style="{DynamicResource PillOutline}" Content="Se déconnecter" Margin="12,0,0,0" Command="{Binding Main.SpotifyLogoutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Fichiers locaux" />
                <TextBlock Text="{Binding Main.Stats}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Main.Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Control}" Padding="12,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE74D;" ToolTip="Retirer ce dossier"
                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{DynamicResource PillButton}" Content="Ajouter un dossier" Command="{Binding Main.AddFolderCommand}" />
                    <Button Style="{DynamicResource PillOutline}" Content="Réanalyser" Margin="12,0,0,0" Command="{Binding Main.RescanCommand}" />
                </StackPanel>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Fonctionnalités" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ce que Sonora affiche. Désactiver une section la retire de Découvrir, de l'accueil et de la recherche."
                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Paroles" IsChecked="{Binding Main.FeatureLyrics}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Podcasts" IsChecked="{Binding Main.FeaturePodcasts}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Vos tops" IsChecked="{Binding Main.FeatureTops}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Historique d'écoute" IsChecked="{Binding Main.FeatureHistory}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Nouveautés de vos artistes" IsChecked="{Binding Main.FeatureNewReleases}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Historique d'écoute local et statistiques" IsChecked="{Binding Main.FeatureListeningLog}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Découverte d'artistes (MusicBrainz, ListenBrainz)" IsChecked="{Binding Main.FeatureDiscovery}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Mémoriser les recherches récentes" IsChecked="{Binding Main.FeatureRecentSearches}" />
                        <CheckBox Style="{DynamicResource Toggle}" Content="Bulle au changement de titre" IsChecked="{Binding Main.FeatureTrackToast}" />

                        <StackPanel Visibility="{Binding Main.FeatureTrackToast, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <TextBlock Text="Durée de la bulle (secondes)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Slider Style="{DynamicResource ThinSlider}" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="260" HorizontalAlignment="Left" Value="{Binding Main.ToastSeconds, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Style="{DynamicResource Toggle}" Content="Mini-lecteur toujours au premier plan" IsChecked="{Binding Main.MiniPlayerOnTop}" />
                        <TextBlock Text="Opacité du mini-lecteur" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <Slider Style="{DynamicResource ThinSlider}" Minimum="0.4" Maximum="1" Width="260" HorizontalAlignment="Left"
                                Value="{Binding Main.MiniPlayerOpacity, Mode=TwoWay}" />

                        <StackPanel Visibility="{Binding Main.FeatureLyrics, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                            <TextBlock Text="Taille des paroles" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Slider Style="{DynamicResource ThinSlider}" Minimum="0.8" Maximum="1.6" Width="260" HorizontalAlignment="Left"
                                    Value="{Binding Main.LyricsScale, Mode=TwoWay}" />
                            <TextBlock Text="Alignement des paroles" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <WrapPanel>
                                <RadioButton Style="{DynamicResource Chip}" GroupName="LyricsAlign" Content="À gauche" Margin="0,0,8,4"
                                             IsChecked="{Binding Main.LyricsAlign, Converter={StaticResource Eq}, ConverterParameter=left}" />
                                <RadioButton Style="{DynamicResource Chip}" GroupName="LyricsAlign" Content="Centré" Margin="0,0,8,4"
                                             IsChecked="{Binding Main.LyricsAlign, Converter={StaticResource Eq}, ConverterParameter=center}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="ListenBrainz" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"
                                   Text="Envoyez vos écoutes à ListenBrainz, le service ouvert d'historique d'écoute — ce que Spotify ne permet à aucune application tierce. Tant que ce champ est vide, rien ne quitte cette machine." />
                        <TextBlock Text="Jeton utilisateur" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Main.ListenBrainzToken, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="Vérifier le jeton" Command="{Binding Main.TestScrobbleCommand}" />
                            <TextBlock Text="Envoi actif" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Accent}"
                                       Visibility="{Binding Main.IsScrobbling, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Raccourcis clavier" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"
                                   Text="Cliquez sur un raccourci puis appuyez sur la combinaison voulue. Une combinaison déjà prise est retirée à son ancienne action. Alt+← / Alt+→ (navigation) et les touches média du clavier ne se changent pas." />
                        <ItemsControl ItemsSource="{Binding Main.ShortcutRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource PillOutline}" MinWidth="130" Padding="12,5"
                                                Content="{Binding Gesture}"
                                                Command="{Binding DataContext.Main.CaptureShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="Tout réinitialiser" Command="{Binding Main.ResetShortcutsCommand}" />
                            <TextBlock Text="En attente d'une combinaison…" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Visibility="{Binding Main.IsCapturingShortcut, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="Mises à jour" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding Main.Updates.VersionLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Main.Updates.Status}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Main.Updates.HasStatus, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Minimum="0" Maximum="100" Height="6" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Accent}"
                                     Value="{Binding Main.Updates.Progress, Mode=OneWay}"
                                     Visibility="{Binding Main.Updates.IsDownloading, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="Rechercher des mises à jour" Command="{Binding Main.Updates.CheckCommand}" />
                            <Button Style="{DynamicResource AccentPill}" Content="{Binding Main.Updates.InstallLabel}" Margin="12,0,0,0" Command="{Binding Main.Updates.InstallCommand}"
                                    Visibility="{Binding Main.Updates.HasUpdate, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{DynamicResource PillOutline}" Content="Page des versions" Margin="12,0,0,0" Command="{Binding Main.Updates.OpenReleasesCommand}"
                                    Visibility="{Binding Main.Updates.IsNotInstalled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <CheckBox Style="{DynamicResource Toggle}" Content="Vérifier les mises à jour à l'ouverture de Sonora" IsChecked="{Binding Main.FeatureUpdateCheck}" Margin="0,16,0,0" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="La vérification interroge GitHub (github.com) et ne lui envoie rien d'autre que ce que toute requête web contient. L'installation n'a jamais lieu sans votre clic." />
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="À propos" />
                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                           Text="Sonora — lecteur de musique natif (.NET 10 / WPF). Fichiers locaux via Windows Media Foundation ; Spotify via l'API Web officielle et le Web Playback SDK. Sonora n'est ni affilié à Spotify ni approuvé par Spotify." />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
