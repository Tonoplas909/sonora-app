                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Main.LanguageOptions}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{DynamicResource Chip}" GroupName="Language" Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.Main.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding Code}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <!-- A translation no native speaker has read yet. -->
                                            <Border x:Name="Badge" Margin="8,0,0,0" Padding="6,1" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                                                    BorderThickness="1" BorderBrush="Transparent"
                                                    ToolTip="{loc:T settings.unreviewed_tip}" Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock x:Name="BadgeText" Text="{loc:T settings.unreviewed}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <DataTemplate.Triggers>
                                        <!-- On the chosen chip the accent is the background: the badge turns into an outline in the on-accent colour. -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="Transparent" />
                                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.OnAccent}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
