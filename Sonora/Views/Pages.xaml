                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource PillOutline}" MinWidth="130" Padding="12,5"
                                                Content="{Binding Gesture}"
                                                Command="{Binding DataContext.Main.CaptureShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="{loc:T pages.reset_all}" Command="{Binding Main.ResetShortcutsCommand}" />
                            <TextBlock Text="{loc:T pages.waiting_for_a_combination}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Visibility="{Binding Main.IsCapturingShortcut, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.updates}" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding Main.Updates.VersionLine}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Main.Updates.Status}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Main.Updates.HasStatus, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Minimum="0" Maximum="100" Height="6" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Accent}"
                                     Value="{Binding Main.Updates.Progress, Mode=OneWay}"
                                     Visibility="{Binding Main.Updates.IsDownloading, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{DynamicResource PillOutline}" Content="{loc:T pages.check_for_updates}" Command="{Binding Main.Updates.CheckCommand}" />
                            <Button Style="{DynamicResource AccentPill}" Content="{Binding Main.Updates.InstallLabel}" Margin="12,0,0,0" Command="{Binding Main.Updates.InstallCommand}"
                                    Visibility="{Binding Main.Updates.HasUpdate, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{DynamicResource PillOutline}" Content="{loc:T pages.releases_page}" Margin="12,0,0,0" Command="{Binding Main.Updates.OpenReleasesCommand}"
                                    Visibility="{Binding Main.Updates.IsNotInstalled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <CheckBox Style="{DynamicResource Toggle}" Content="{loc:T pages.check_for_updates_when_sonora_opens}" IsChecked="{Binding Main.FeatureUpdateCheck}" Margin="0,16,0,0" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{loc:T pages.the_check_contacts_github_github_com}" />
                    </StackPanel>
                </Border>

                <ContentControl Style="{DynamicResource SectionTitleBox}" Content="{loc:T pages.about}" />
                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                           Text="{loc:T pages.sonora_a_native_music_player_net_10}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
