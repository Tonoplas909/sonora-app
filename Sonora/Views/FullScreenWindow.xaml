<Window x:Class="Sonora.Views.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sonora.Views"
        Title="Sonora — plein écran" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        ShowInTaskbar="True" UseLayoutRounding="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Size.Text.Body}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid MouseLeftButtonDown="Background_MouseDown" MouseLeftButtonUp="Background_MouseUp" MouseMove="Background_MouseMove">
        <!-- The cover again, blurred and dimmed, as the backdrop. -->
        <Grid.Background>
            <ImageBrush ImageSource="{Binding Player.Current.AlbumRef.ArtPath, Converter={StaticResource Art}, ConverterParameter=600}"
                        Stretch="UniformToFill" Opacity="0.22">
                <ImageBrush.RelativeTransform>
                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.2" ScaleY="1.2" />
                </ImageBrush.RelativeTransform>
            </ImageBrush>
        </Grid.Background>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <Button x:Name="ScreenButton" Style="{DynamicResource IconButton}" Content="&#xE7F4;" FontSize="18" Margin="0,0,8,0"
                    Click="Screen_Click" ToolTip="Changer d'écran (S) — ou faites glisser la fenêtre" />
            <Button Style="{DynamicResource IconButton}" Content="&#xE73F;" FontSize="18"
                    Click="Close_Click" ToolTip="Quitter le plein écran (Échap)" />
        </StackPanel>

        <TextBlock Text="Rien en cours de lecture" Foreground="{DynamicResource Brush.TextSecondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"
                   Visibility="{Binding Player.HasTrack, Converter={StaticResource InvBoolToVis}}" />

        <Grid Margin="64,48" MaxWidth="1700" HorizontalAlignment="Stretch" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- The cover takes a share of the window rather than a fixed size: a 4K screen gets a 4K cover. -->
            <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" v:Motion.OnChange="{Binding Player.Current}">
                <Grid Width="420" Height="420">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.55" />
                    </Grid.Effect>
                    <Border CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" FontSize="120" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border CornerRadius="{DynamicResource Radius.Panel}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Player.Current.AlbumRef.ArtPath, Converter={StaticResource Art}, ConverterParameter=900}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Viewbox>

            <!-- Nothing here depends on the lyrics: the title block keeps its place and the lyrics zone has a fixed
                 height, so no line, long or short, moves anything else. -->
            <StackPanel Grid.Column="1" Margin="56,0,0,0" VerticalAlignment="Center">
                <StackPanel v:Motion.SwipeOnChange="{Binding Player.Current}">
                    <TextBlock Text="{Binding Player.Current.Title}" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold"
                               FontSize="54" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Player.Current.Artist}" FontSize="24" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Player.ContextName}" FontSize="15" Margin="0,16,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- One line at a time: no scrolling to follow, and it stays readable from across the room. -->
                <Border Height="216" Margin="0,40,0,0" ClipToBounds="True">
                    <StackPanel Visibility="{Binding Lyrics.HasSynced, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Lyrics.CurrentLine}" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold"
                                   FontSize="32" TextWrapping="Wrap" MaxHeight="134" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Accent}" v:Motion.RiseOnChange="{Binding Lyrics.CurrentLine}" />
                        <TextBlock Text="{Binding Lyrics.NextLine}" FontSize="22" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="68"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}"
                                   v:Motion.RiseOnChange="{Binding Lyrics.NextLine}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,40,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <!-- Fixed-width time columns: the bar does not change width as the digits do. -->
                    <TextBlock Text="{Binding Player.PositionText}" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontFamily="{DynamicResource Font.Numbers}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0" />
                    <Slider Grid.Column="1" Style="{DynamicResource ThinSlider}" Minimum="0" Maximum="{Binding Player.SliderMax}"
                            Value="{Binding Player.SeekValue, Mode=TwoWay}" VerticalAlignment="Center"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" />
                    <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontFamily="{DynamicResource Font.Numbers}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8B1;" FontSize="20" Width="48" Height="48"
                            Command="{Binding ToggleShuffleCommand}" ToolTip="Lecture aléatoire" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE892;" FontSize="22" Width="48" Height="48" Margin="12,0,0,0"
                            Command="{Binding PreviousCommand}" ToolTip="Précédent" />
                    <Button Style="{DynamicResource BigPlay}" Margin="20,0" Command="{Binding TogglePlayCommand}" ToolTip="Lecture / pause" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE893;" FontSize="22" Width="48" Height="48" Margin="0,0,12,0"
                            Command="{Binding NextCommand}" ToolTip="Suivant" />
                    <Button Style="{DynamicResource IconButton}" Content="{Binding Player.RepeatGlyph}" FontSize="20" Width="48" Height="48"
                            Command="{Binding CycleRepeatCommand}" ToolTip="Répéter" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
