<p:PanelView x:Class="Sonora.Views.Panels.NavigationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Sonora.Views.Panels"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl Margin="4" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding PanelOrientation, ElementName=Root}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Button Style="{DynamicResource NavItem}" Command="{Binding GoHomeCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Accueil" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Large}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{DynamicResource NavItem}" Command="{Binding GoSearchCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Rechercher" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Large}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{DynamicResource NavItem}" Command="{Binding OpenDiscoverCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE1D3;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Découvrir" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Large}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{DynamicResource NavItem}" Command="{Binding OpenAppearanceCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Apparence" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Large}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{DynamicResource NavItem}" Command="{Binding OpenSettingsCommand}" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Paramètres" FontWeight="Bold" FontSize="{DynamicResource Size.Text.Large}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </ItemsControl>
    </ScrollViewer>
</p:PanelView>
