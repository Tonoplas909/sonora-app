<p:PanelView x:Class="Sonora.Views.Panels.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Sonora.Views.Panels"
             xmlns:v="clr-namespace:Sonora.Views">
    <DockPanel Margin="8,0,4,4" TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T queue.now_playing}" FontWeight="SemiBold" Margin="4,4,0,8" />
        <Grid DockPanel.Dock="Top" Height="{DynamicResource Size.Row}" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}"
              v:Motion.OnChange="{Binding Player.Current}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                <Border CornerRadius="{DynamicResource Radius.Art}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Player.Current.ArtPath, Converter={StaticResource Art}, ConverterParameter=80}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                <TextBlock Text="{Binding Player.Current.Title}" Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Player.Current.Artist}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,16,0,8" TextTrimming="CharacterEllipsis">
            <Run Text="{loc:T queue.next_up}" /><Run Text=" • " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{Binding Player.ContextName, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
        </TextBlock>
        <ListBox Style="{StaticResource TrackList}" ItemTemplate="{DynamicResource QueueRowTemplate}" ItemsSource="{Binding Player.Upcoming}" />
    </DockPanel>
</p:PanelView>
