<p:PanelView x:Class="Sonora.Views.Panels.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Sonora.Views.Panels"
             xmlns:v="clr-namespace:Sonora.Views"
             x:Name="Root">
    <p:PanelView.Resources>
        <!-- Shared pieces of both layouts -->
        <Style x:Key="ShuffleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE8B1;" />
            <Setter Property="ToolTip" Value="Lecture aléatoire (Ctrl+S)" />
            <Setter Property="Command" Value="{Binding ToggleShuffleCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.Shuffle}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepeatButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="{Binding Player.RepeatGlyph}" />
            <Setter Property="ToolTip" Value="Répéter (Ctrl+R)" />
            <Setter Property="Command" Value="{Binding CycleRepeatCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.RepeatActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource PlayCircle}">
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="Lecture" />
            <Setter Property="Command" Value="{Binding TogglePlayCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="ToolTip" Value="Pause" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LikeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <EventSetter Event="Click" Handler="Like_Click" />
            <Setter Property="Content" Value="&#xEB51;" />
            <Setter Property="Command" Value="{Binding ToggleLikeCurrentCommand}" />
            <Setter Property="ToolTip" Value="Ajouter aux Titres likés" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.Current.IsLiked}" Value="True">
                    <Setter Property="Content" Value="&#xEB52;" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="ToolTip" Value="Retirer des Titres likés" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE8FD;" />
            <Setter Property="ToolTip" Value="File d'attente (Ctrl+Q)" />
            <Setter Property="Command" Value="{Binding ToggleQueueCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQueueVisible}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LyricsButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE720;" />
            <Setter Property="ToolTip" Value="Paroles" />
            <Setter Property="Command" Value="{Binding ToggleLyricsCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLyricsVisible}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniPlayerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE944;" />
            <Setter Property="ToolTip" Value="Mini-lecteur (Ctrl+M)" />
        </Style>
        <Style x:Key="FullScreenButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE740;" />
            <Setter Property="ToolTip" Value="Plein écran (F11)" />
        </Style>
        <Style x:Key="SleepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xEC46;" />
            <Setter Property="ToolTip" Value="Minuteur de veille" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSleepActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="ToolTip" Value="{Binding SleepStatus}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One panel, three faces, chosen by the room it has: a transport bar, a wide now-playing bar, or
             a tall now-playing column. Only the matching one is ever visible. -->
        <Style x:Key="CompactOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode, ElementName=Root}" Value="Compact">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WideOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode, ElementName=Root}" Value="Wide">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TallOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode, ElementName=Root}" Value="Tall">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The pieces below are shared by both now-playing faces, which differ only in how they arrange them. -->
        <DataTemplate x:Key="BigCover">
            <Viewbox Stretch="Uniform" StretchDirection="Both" v:Motion.OnChange="{Binding Player.Current}" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
                <Grid Width="300" Height="300">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" />
                    </Grid.Effect>
                    <Border CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" FontSize="90" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border CornerRadius="{DynamicResource Radius.Panel}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Player.Current.AlbumRef.ArtPath, Converter={StaticResource Art}, ConverterParameter=600}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="TrackDetails">
            <DockPanel v:Motion.OnChange="{Binding Player.Current}" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource LikeButton}" FontSize="20" VerticalAlignment="Center" />
                <StackPanel>
                    <Button Style="{StaticResource LinkText}" Content="{Binding Player.Current.Title}" FontSize="{DynamicResource Size.Text.Section}"
                            FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" Command="{Binding OpenCurrentAlbumCommand}" />
                    <Button Style="{StaticResource LinkText}" Content="{Binding Player.Current.Artist}" FontSize="{DynamicResource Size.Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                            Margin="0,4,0,0" Command="{Binding OpenCurrentArtistCommand}" />
                    <TextBlock Text="{Binding Player.Current.Album}" FontSize="{DynamicResource Size.Text.Small}" Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Player.ContextLabel}" FontSize="{DynamicResource Size.Text.Small}" Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Player.ContextLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="SeekRow">
            <StackPanel>
                <Slider Style="{DynamicResource ThinSlider}" Minimum="0" Maximum="{Binding Player.SliderMax}" Value="{Binding Player.SeekValue, Mode=TwoWay}" Margin="0,12,0,0"
                        Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" />
                <DockPanel TextElement.FontSize="{DynamicResource Size.Text.Small}" TextElement.Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Player.DurationText}" FontFamily="{DynamicResource Font.Numbers}" />
                    <TextBlock Text="{Binding Player.PositionText}" FontFamily="{DynamicResource Font.Numbers}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TransportRow">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource ShuffleButton}" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE892;" Margin="4,0,0,0" Command="{Binding PreviousCommand}" ToolTip="{loc:T common.previous}" />
                <Button Style="{StaticResource PlayPauseButton}" Margin="10,0" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE893;" Margin="0,0,4,0" Command="{Binding NextCommand}" ToolTip="{loc:T common.next}" />
                <Button Style="{StaticResource RepeatButton}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SecondaryRow">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{DynamicResource IconButton}" Content="&#xE7F4;" ToolTip="{loc:T player.spotify_connect_devices}" Click="Devices_Click"
                        Visibility="{Binding Spotify.IsConnected, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource MiniPlayerButton}" Click="MiniPlayer_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource FullScreenButton}" Click="FullScreen_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource SleepButton}" Click="Sleep_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource QueueButton}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource LyricsButton}" />
                <Button DockPanel.Dock="Left" Style="{DynamicResource IconButton}" Content="{Binding Player.VolumeGlyph}" Command="{Binding ToggleMuteCommand}" ToolTip="{loc:T player.mute}" />
                <Slider Style="{DynamicResource ThinSlider}" Minimum="0" Maximum="100" v:WheelStep.Step="5" Value="{Binding Player.Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="RemoteNote">
            <TextBlock Foreground="{DynamicResource Brush.Accent}" FontSize="{DynamicResource Size.Text.Small}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Player.IsRemote, Converter={StaticResource BoolToVis}}">
                <Run Text="{loc:T player.playing_on}" /><Run Text=" " /><Run Text="{Binding Player.RemoteDeviceName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="NothingPlaying">
            <TextBlock Text="{loc:T common.nothing_is_playing}" Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Player.HasTrack, Converter={StaticResource InvBoolToVis}}" />
        </DataTemplate>
    </p:PanelView.Resources>

    <Grid TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
        <!-- ===== Compact: the transport bar =====
             Three groups side by side. As the panel narrows the elements drop out one at a time, least important
             first, until only previous / play / next remain; when it is narrow but has height to spare, the
             groups stack one above another instead (see AdaptiveFlow and PriorityRow). -->
        <v:AdaptiveFlow Style="{StaticResource CompactOnly}" Margin="8,4" Spacing="12">
            <!-- Track: cover, title and artist, like -->
            <v:PriorityRow v:Adaptive.Priority="6" v:Adaptive.Weight="3" v:Adaptive.Basis="300" Spacing="14" VerticalAlignment="Center"
                           Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
                <Grid v:Adaptive.Priority="4" Width="56" Height="56" v:Motion.OnChange="{Binding Player.Current}">
                    <Border CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" Foreground="{DynamicResource Brush.TextMuted}" FontSize="20" />
                    </Border>
                    <Border CornerRadius="{DynamicResource Radius.Art}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Player.Current.AlbumRef.ArtPath, Converter={StaticResource Art}, ConverterParameter=112}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel v:Adaptive.Priority="6" v:Adaptive.Weight="1" MinWidth="90" MaxWidth="340" VerticalAlignment="Center" v:Motion.OnChange="{Binding Player.Current}">
                    <Button Style="{StaticResource LinkText}" Content="{Binding Player.Current.Title}" FontSize="{DynamicResource Size.Text.Body}" Command="{Binding OpenCurrentAlbumCommand}" />
                    <Button Style="{StaticResource LinkText}" Content="{Binding Player.Current.Artist}" FontSize="{DynamicResource Size.Text.Small}" Foreground="{DynamicResource Brush.TextSecondary}"
                            Margin="0,2,0,0" Command="{Binding OpenCurrentArtistCommand}" />
                </StackPanel>
                <Button v:Adaptive.Priority="5" Style="{StaticResource LikeButton}" VerticalAlignment="Center" />
            </v:PriorityRow>

            <!-- Transport and seek bar: the three main buttons are what stays until the very end -->
            <v:PriorityRow v:Adaptive.Priority="10" v:Adaptive.Weight="4" v:Adaptive.Basis="440" Orientation="Vertical" Align="Center" VerticalAlignment="Center">
                <v:PriorityRow v:Adaptive.Priority="10" Align="Center">
                    <Button v:Adaptive.Priority="3" Style="{StaticResource ShuffleButton}" Margin="0,0,8,0" />
                    <Button v:Adaptive.Priority="10" Style="{DynamicResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="{loc:T common.previous}" />
                    <Button v:Adaptive.Priority="10" Style="{StaticResource PlayPauseButton}" Margin="12,0" />
                    <Button v:Adaptive.Priority="10" Style="{DynamicResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="{loc:T common.next}" />
                    <Button v:Adaptive.Priority="3" Style="{StaticResource RepeatButton}" Margin="8,0,0,0" />
                </v:PriorityRow>
                <v:PriorityRow v:Adaptive.Priority="6" Margin="0,4,0,0">
                    <TextBlock v:Adaptive.Priority="4" Text="{Binding Player.PositionText}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                               FontSize="{DynamicResource Size.Text.Small}" Width="52" TextAlignment="Right" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <Slider v:Adaptive.Priority="10" v:Adaptive.Weight="1" MinWidth="60" Style="{DynamicResource ThinSlider}" Minimum="0" Maximum="{Binding Player.SliderMax}" Value="{Binding Player.SeekValue, Mode=TwoWay}"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" VerticalAlignment="Center" />
                    <TextBlock v:Adaptive.Priority="4" Text="{Binding Player.DurationText}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                               FontSize="{DynamicResource Size.Text.Small}" Width="52" VerticalAlignment="Center" Padding="8,0,0,0" />
                </v:PriorityRow>
            </v:PriorityRow>

            <!-- Tools: the first to go -->
            <v:PriorityRow v:Adaptive.Priority="3" v:Adaptive.Weight="3" v:Adaptive.Basis="400" Align="End" VerticalAlignment="Center">
                <TextBlock v:Adaptive.Priority="1" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" FontSize="{DynamicResource Size.Text.Small}" Margin="0,0,8,0" MaxWidth="160"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding Player.IsRemote, Converter={StaticResource BoolToVis}}">
                    <Run Text="{loc:T player.playing_on}" /><Run Text=" " /><Run Text="{Binding Player.RemoteDeviceName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button v:Adaptive.Priority="3" Style="{DynamicResource IconButton}" Content="&#xE7F4;" ToolTip="{loc:T player.spotify_connect_devices}" Click="Devices_Click"
                        Visibility="{Binding Spotify.IsConnected, Converter={StaticResource BoolToVis}}" />
                <Button v:Adaptive.Priority="2" Style="{StaticResource MiniPlayerButton}" Click="MiniPlayer_Click" />
                <Button v:Adaptive.Priority="2" Style="{StaticResource FullScreenButton}" Click="FullScreen_Click" />
                <Button v:Adaptive.Priority="2" Style="{StaticResource SleepButton}" Click="Sleep_Click" />
                <Button v:Adaptive.Priority="4" Style="{StaticResource QueueButton}" />
                <Button v:Adaptive.Priority="4" Style="{StaticResource LyricsButton}" />
                <Button v:Adaptive.Priority="6" Style="{DynamicResource IconButton}" Content="{Binding Player.VolumeGlyph}" Margin="8,0,4,0" Command="{Binding ToggleMuteCommand}" ToolTip="{loc:T player.mute}" />
                <Slider v:Adaptive.Priority="5" Style="{DynamicResource ThinSlider}" Width="110" Minimum="0" Maximum="100" v:WheelStep.Step="5" Value="{Binding Player.Volume, Mode=TwoWay}" VerticalAlignment="Center" />
            </v:PriorityRow>
        </v:AdaptiveFlow>

        <!-- ===== Wide: a big cover on the left, the track and its controls beside it =====
             This is what a bottom-docked player grows into, since a bottom zone is capped at 40% of the
             window height and so never gets deep enough for the tall face. -->
        <Grid Style="{StaticResource WideOnly}" Margin="12,8,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource NothingPlaying}" Content="{Binding}" Grid.ColumnSpan="2" />
            <ContentControl ContentTemplate="{StaticResource BigCover}" Content="{Binding}" Margin="0,0,20,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
                <ContentControl ContentTemplate="{StaticResource TrackDetails}" Content="{Binding}" />
                <ContentControl ContentTemplate="{StaticResource SeekRow}" Content="{Binding}" />
                <ContentControl ContentTemplate="{StaticResource TransportRow}" Content="{Binding}" Margin="0,10,0,0" />
                <ContentControl ContentTemplate="{StaticResource SecondaryRow}" Content="{Binding}" Margin="0,10,0,0" />
                <ContentControl ContentTemplate="{StaticResource RemoteNote}" Content="{Binding}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===== Tall: the cover above the track and its controls =====
             A grid, not a stack: the cover takes the star row and gives way as the panel shrinks, so the
             details and the transport stay in view instead of scrolling off the bottom. -->
        <Grid Style="{StaticResource TallOnly}" Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl ContentTemplate="{StaticResource NothingPlaying}" Content="{Binding}" />
            <ContentControl ContentTemplate="{StaticResource BigCover}" Content="{Binding}" />
            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource TrackDetails}" Content="{Binding}" Margin="0,14,0,0" />
            <ContentControl Grid.Row="2" ContentTemplate="{StaticResource SeekRow}" Content="{Binding}" />
            <ContentControl Grid.Row="3" ContentTemplate="{StaticResource TransportRow}" Content="{Binding}" Margin="0,10,0,0" />
            <ContentControl Grid.Row="4" ContentTemplate="{StaticResource SecondaryRow}" Content="{Binding}" Margin="0,10,0,0" />
            <ContentControl Grid.Row="5" ContentTemplate="{StaticResource RemoteNote}" Content="{Binding}" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</p:PanelView>
