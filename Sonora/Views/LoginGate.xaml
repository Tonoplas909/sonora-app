<UserControl x:Class="Sonora.Views.LoginGate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="520" Margin="24,48" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource Brush.Surface}" CornerRadius="{DynamicResource Radius.Panel}" Padding="40,36"
                TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
            <StackPanel>
                <Image Source="{DynamicResource Image.AppIcon}" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{loc:T login.welcome_to_sonora}" FontSize="{DynamicResource Size.Text.Title}" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{loc:T login.connect_your_spotify_premium_account}" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                <TextBlock Text="{loc:T login.client_id_of_your_spotify_application}" FontWeight="SemiBold" Margin="0,28,0,6" />
                <TextBox Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" />

                <Button Margin="0,20,0,0" Padding="20,12" Command="{Binding SpotifyLoginCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentPill}">
                            <Setter Property="Content" Value="Se connecter avec Spotify" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Spotify.IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Connexion dans votre navigateur…" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding Spotify.Status}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0" />

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T login.first_time}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextWrapping="Wrap"
                                   Text="{loc:T login.create_an_application_on_the_spotify}" />
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE8C8;" ToolTip="{loc:T common.copy}" Command="{Binding CopyRedirectUriCommand}" />
                            <TextBox Text="{Binding RedirectUri, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>
                        <Button Style="{StaticResource LinkText}" Content="{loc:T login.open_the_developer_dashboard}" Foreground="{DynamicResource Brush.Accent}"
                                Margin="0,10,0,0" Command="{Binding OpenDeveloperDashboardCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
