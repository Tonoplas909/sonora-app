<ResourceDictionary x:Class="Sonora.Views.Templates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Sonora.ViewModels"
                    xmlns:m="clr-namespace:Sonora.Models"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- ============ Track rows ============ -->

    <Style x:Key="TrackItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Padding="0,0,8,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Every other row tinted (transparent except in the Studio style) -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.RowAlt}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <EventSetter Event="MouseDoubleClick" Handler="TrackItem_DoubleClick" />
        <EventSetter Event="PreviewMouseRightButtonUp" Handler="TrackItem_RightClick" />
        <!-- Dragging tracks: onto a playlist in the library panel, or onto another row to reorder. -->
        <Setter Property="AllowDrop" Value="True" />
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TrackItem_DragArm" />
        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TrackItem_DragCancel" />
        <EventSetter Event="PreviewMouseMove" Handler="TrackItem_DragMove" />
        <EventSetter Event="DragOver" Handler="TrackItem_DragOver" />
        <EventSetter Event="Drop" Handler="TrackItem_Drop" />
        <Style.Triggers>
            <!-- A local file listed in a Spotify playlist that is not on this machine: shown, but cannot be played until located. -->
            <DataTrigger Binding="{Binding Track.IsMissing}" Value="True">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="ToolTip" Value="{loc:T playlist.file_missing}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Play button over a cover, shown while the row is hovered: one click starts the track, as in Spotify. -->
    <Style x:Key="CoverPlay" TargetType="Button">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Content" Value="&#xE768;" />
        <Setter Property="ToolTip" Value="Lire" />
        <Setter Property="v:Motion.FadeOnShow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Radius.Art}" Background="#99000000">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Track.IsCurrent}" Value="True" />
                    <Condition Binding="{Binding DataContext.Player.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content" Value="&#xE769;" />
                <Setter Property="ToolTip" Value="Pause" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The cover of a track row with its hover play button. Shared, so a style that redraws the rows keeps the behaviour. -->
    <DataTemplate x:Key="TrackCover" DataType="{x:Type m:TrackRow}">
        <Grid>
                <Border CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8D6;" Foreground="{DynamicResource Brush.TextMuted}" />
                </Border>
                <Border CornerRadius="{DynamicResource Radius.Art}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Track.ArtPath, Converter={StaticResource Art}, ConverterParameter=80}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Button Style="{StaticResource CoverPlay}" Click="CoverPlay_Click" />
            </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type m:TrackRow}">
        <Grid Height="{DynamicResource Size.Row}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                       FontSize="{DynamicResource Size.Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="Eq" Style="{StaticResource GlyphText}" Text="&#xE995;" Foreground="{DynamicResource Brush.Accent}"
                       HorizontalAlignment="Right" Margin="0,0,12,0" Visibility="Collapsed" v:Motion.FadeOnShow="True" />
            <ContentControl Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" ContentTemplate="{DynamicResource TrackCover}" Content="{Binding}" Focusable="False" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                <TextBlock x:Name="TitleText" Text="{Binding Track.Title}" FontSize="{DynamicResource Size.Text.Large}" FontFamily="{DynamicResource Font.UI}"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Track.Artist}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Track.Album}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <Button x:Name="Heart" Grid.Column="4" Style="{DynamicResource IconButton}" Content="&#xEB51;" Opacity="0"
                    Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Track}" ToolTip="{loc:T common.add_to_liked_songs}" />
            <TextBlock Grid.Column="5" Text="{Binding Track.DurationText}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                       FontSize="{DynamicResource Size.Text.Small}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsLiked}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
                <Setter TargetName="Heart" Property="Content" Value="&#xEB52;" />
                <Setter TargetName="Heart" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Heart" Property="ToolTip" Value="Retirer des Titres likés" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsCurrent}" Value="True">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Column header aligned with TrackRowTemplate -->
    <DataTemplate x:Key="TrackHeaderTemplate">
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,8,8"
                TextElement.Foreground="{DynamicResource Brush.TextSecondary}" TextElement.FontSize="{DynamicResource Size.Text.Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" HorizontalAlignment="Right" Margin="0,0,14,0" />
                <TextBlock Grid.Column="2" Text="{loc:T common.title}" Margin="12,0,0,0" />
                <TextBlock Grid.Column="3" Text="{loc:T common.album}" />
                <TextBlock Grid.Column="5" Text="&#xE823;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="QueueRowTemplate" DataType="{x:Type m:TrackRow}">
        <Grid Height="{DynamicResource Size.Row}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ContentControl Width="40" Height="40" ContentTemplate="{DynamicResource TrackCover}" Content="{Binding}" Focusable="False" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                <TextBlock Text="{Binding Track.Title}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="{DynamicResource Size.Text.Body}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Track.Artist}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Virtualized, self-scrolling list -->
    <Style x:Key="TrackList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemTemplate" Value="{DynamicResource TrackRowTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource TrackItem}" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Short list embedded inside a page ScrollViewer -->
    <Style x:Key="TrackListStatic" TargetType="ListBox" BasedOn="{StaticResource TrackList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Library entries ============ -->

    <Style x:Key="LibraryItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Padding="8,4">
                            <ContentPresenter />
                        </Border>
                        <!-- Shown while tracks are dragged over the entry (accepted), and as a pulse once they have landed. -->
                        <Border x:Name="DropRing" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="2"
                                BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.AccentSoft}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                        <Trigger Property="v:TrackDragDrop.DropState" Value="Accepts">
                            <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="v:TrackDragDrop.DropState" Value="Refuses">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="v:TrackDragDrop.DropState" Value="Landed">
                            <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DropRing" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.65" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="LibraryItem_DragArm" />
        <EventSetter Event="PreviewMouseMove" Handler="LibraryItem_DragMove" />
        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="LibraryItem_Click" />
        <EventSetter Event="PreviewMouseRightButtonUp" Handler="LibraryItem_RightClick" />
        <Setter Property="AllowDrop" Value="True" />
        <EventSetter Event="DragOver" Handler="LibraryItem_DragOver" />
        <EventSetter Event="DragLeave" Handler="LibraryItem_DragLeave" />
        <EventSetter Event="Drop" Handler="LibraryItem_Drop" />
    </Style>

    <DataTemplate x:Key="LibraryEntryTemplate" DataType="{x:Type vm:LibraryEntry}">
        <Grid Height="{DynamicResource Size.Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Ph" Width="{DynamicResource Size.RowCover}" Height="{DynamicResource Size.RowCover}" CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                <TextBlock x:Name="PhGlyph" Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource Brush.TextMuted}" />
            </Border>
            <Border x:Name="Img" Width="{DynamicResource Size.RowCover}" Height="{DynamicResource Size.RowCover}" CornerRadius="{DynamicResource Radius.Art}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Source.ArtPath, Converter={StaticResource Art}, ConverterParameter=96}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <!-- Ring around the cover of what is playing: still visible when the panel shows covers only. -->
            <Border x:Name="Ring" Width="{DynamicResource Size.RowCover}" Height="{DynamicResource Size.RowCover}" CornerRadius="{DynamicResource Radius.Art}" BorderThickness="2"
                    BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
            <StackPanel x:Name="Texts" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="{DynamicResource Size.Text.Body}" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Size.Text.Small}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="Pin" Grid.Column="2" Text="&#xE840;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="6,0,6,0"
                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" ToolTip="{loc:T templates.pinned}" />
            <!-- Equalizer bars: dancing while the music plays, still while it is paused. -->
            <StackPanel x:Name="Bars" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,6,0" Visibility="Collapsed" Height="14">
                <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="0,0,2,0" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="0,0,2,0" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar3" Width="3" Height="14" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRound}" Value="True">
                <Setter TargetName="Ph" Property="CornerRadius" Value="22" />
                <Setter TargetName="Img" Property="CornerRadius" Value="22" />
                <Setter TargetName="Ring" Property="CornerRadius" Value="22" />
            </DataTrigger>
            <!-- What the current track is played from: paused (1) or playing (2) -->
            <DataTrigger Binding="{Binding PlayState}" Value="1">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Bars" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PlayState}" Value="2">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Bars" Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Dance">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.25" To="1" Duration="0:0:0.45" />
                            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.3" Duration="0:0:0.6" />
                            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.3" To="0.9" Duration="0:0:0.35" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Dance" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                <Setter TargetName="Ph" Property="Background" Value="{DynamicResource Brush.SpecialGradient}" />
                <Setter TargetName="PhGlyph" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </DataTrigger>
            <!-- Narrow library panel: covers only -->
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=v:LibraryList}}" Value="True">
                <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Pin" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Bars" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Cards ============ -->

    <!-- What a card shows when its album, artist or playlist is what the current track comes from. The state
         (0, 1 paused, 2 playing) is the Tag of the card's root panel; see PlayingContext. -->
    <Style x:Key="PlayingText" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="1">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="2">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PlayingText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,2" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Body}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <DataTemplate x:Key="PlayingBadge">
        <Grid IsHitTestVisible="False">
            <Border x:Name="Ring" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed"
                    CornerRadius="{DynamicResource Radius.Art}" />
            <Border x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="7,5" CornerRadius="10"
                    Background="#B3000000" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Height="14">
                    <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="0,0,2,0" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="0,0,2,0" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar3" Width="3" Height="14" Fill="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <!-- Small covers (the rows of the Studio style) -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Small">
                <Setter TargetName="Pill" Property="Margin" Value="2" />
                <Setter TargetName="Pill" Property="Padding" Value="3,2" />
                <Setter TargetName="Pill" Property="CornerRadius" Value="3" />
                <Setter TargetName="Ring" Property="CornerRadius" Value="0" />
            </DataTrigger>
            <!-- Artists have round covers -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Round">
                <Setter TargetName="Ring" Property="CornerRadius" Value="999" />
                <Setter TargetName="Pill" Property="Margin" Value="8,8,8,18" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="1">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="2">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Dance">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.25" To="1" Duration="0:0:0.45" />
                            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.3" Duration="0:0:0.6" />
                            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.3" To="0.9" Duration="0:0:0.35" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Dance" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AlbumCard" DataType="{x:Type m:Album}">
        <Button Style="{DynamicResource CardButton}"
                Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Tag>
                <MultiBinding Converter="{StaticResource PlayingContext}">
                    <Binding />
                    <Binding Path="DataContext.Player.ContextUri" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.ContextName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.HasTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.Current" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Button.Tag>
            <StackPanel Width="{DynamicResource Size.Card}">
                <Grid Width="{DynamicResource Size.Card}" Height="{DynamicResource Size.Card}">
                    <Border CornerRadius="{DynamicResource Radius.Art}" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE93C;" FontSize="44" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border CornerRadius="{DynamicResource Radius.Art}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtPath, Converter={StaticResource Art}, ConverterParameter=card}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ContentControl ContentTemplate="{StaticResource PlayingBadge}" Content="{Binding}" />
                    <Button Style="{DynamicResource PlayBubble}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                            Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource CardTitle}" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="ArtistCard" DataType="{x:Type m:Artist}">
        <Button Style="{DynamicResource CardButton}"
                Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Tag>
                <MultiBinding Converter="{StaticResource PlayingContext}">
                    <Binding />
                    <Binding Path="DataContext.Player.ContextUri" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.ContextName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.HasTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.Current" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Button.Tag>
            <StackPanel Width="{DynamicResource Size.Card}">
                <Grid Width="{DynamicResource Size.Card}" Height="{DynamicResource Size.Card}">
                    <Border CornerRadius="999" Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE77B;" FontSize="44" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border CornerRadius="999">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtPath, Converter={StaticResource Art}, ConverterParameter=card}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ContentControl ContentTemplate="{StaticResource PlayingBadge}" Content="{Binding}" />
                    <Button Style="{DynamicResource PlayBubble}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                            Command="{Binding DataContext.PlayArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Name}" Style="{DynamicResource CardTitle}" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistCard" DataType="{x:Type m:SpotifyPlaylist}">
