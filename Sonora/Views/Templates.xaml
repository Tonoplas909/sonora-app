    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <WrapPanel />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="ShelfPanelTemplate">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

</ResourceDictionary>
