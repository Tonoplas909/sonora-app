<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Sonora.Models"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- "Fonction": a technical data sheet. Light sheets in a dark chassis, ruled in hairlines, a DIN-style face set
         small and exact. One colour only, orange, and it marks what is playing and the one thing to press. -->

    <CornerRadius x:Key="Shape.Icon">3</CornerRadius>
    <CornerRadius x:Key="Shape.Nav">3</CornerRadius>
    <CornerRadius x:Key="Shape.Play">3</CornerRadius>
    <CornerRadius x:Key="Shape.Big">4</CornerRadius>
    <CornerRadius x:Key="Shape.Pill">3</CornerRadius>
    <CornerRadius x:Key="Shape.Chip">3</CornerRadius>

    <Style x:Key="PanelFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.Panel}" />
    </Style>

    <Style x:Key="CenterSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ===== Page header: a flat grey band closed by a hairline ===== -->

    <Style x:Key="HeaderBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,18,24,18" />
    </Style>

    <Style x:Key="HeaderCoverStyle" TargetType="Grid" />

    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Title}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <!-- ===== Headings: ruled like a spec sheet ===== -->

    <Style x:Key="SectionTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,26,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.Text.Large}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,6,0,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0,0,0,2" Padding="0,0,0,8">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.Text.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Controls: square-edged, hairline-bordered; orange only on the one thing to press ===== -->

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Shape.Pill}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="PillOutline" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Small}" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" BorderBrush="{DynamicResource Brush.TextMuted}" BorderThickness="1" CornerRadius="{DynamicResource Shape.Chip}"
                            Padding="10,4" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Body}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.TextMuted}"
                                       VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards: a specimen frame, hairline, darker under the pointer ===== -->

    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PlayingText}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Body}" />
        <Setter Property="Margin" Value="0,8,0,2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== Track rows: a table. Hairline under each, the playing one flagged by an orange bar on its edge ===== -->

    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type m:TrackRow}">
        <Border x:Name="Row" Height="{DynamicResource Size.Row}" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="Flag" Width="3" HorizontalAlignment="Left" Grid.ColumnSpan="6" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="{DynamicResource Font.Numbers}"
                           FontSize="{DynamicResource Size.Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="Eq" Style="{StaticResource GlyphText}" Text="&#xE995;" Foreground="{DynamicResource Brush.Accent}"
                           HorizontalAlignment="Right" Margin="0,0,12,0" Visibility="Collapsed" />
                <ContentControl Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Left" ContentTemplate="{DynamicResource TrackCover}" Content="{Binding}" Focusable="False" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                    <TextBlock x:Name="TitleText" Text="{Binding Track.Title}" FontSize="{DynamicResource Size.Text.Body}" FontFamily="{DynamicResource Font.Display}"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Track.Artist}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Track.Album}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <Button x:Name="Heart" Grid.Column="4" Style="{DynamicResource IconButton}" Content="&#xEB51;" Opacity="0"
                        Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Track}" ToolTip="{loc:T common.add_to_liked_songs}" />
                <TextBlock Grid.Column="5" Text="{Binding Track.DurationText}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                           FontSize="{DynamicResource Size.Text.Small}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsLiked}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
                <Setter TargetName="Heart" Property="Content" Value="&#xEB52;" />
                <Setter TargetName="Heart" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Heart" Property="ToolTip" Value="Retirer des Titres likés" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsCurrent}" Value="True">
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
