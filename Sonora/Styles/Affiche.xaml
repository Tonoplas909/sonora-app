<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Sonora.Models"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- "Affiche": a concert poster. Flat colour fields with nothing between them but a thin ink gap, no corners,
         no shadows, extended black type set very large, and rows, cards and menu entries that invert to ink
         when the pointer is on them. -->

    <CornerRadius x:Key="Shape.Icon">0</CornerRadius>
    <CornerRadius x:Key="Shape.Nav">0</CornerRadius>
    <CornerRadius x:Key="Shape.Play">0</CornerRadius>
    <CornerRadius x:Key="Shape.Big">0</CornerRadius>
    <CornerRadius x:Key="Shape.Pill">0</CornerRadius>
    <CornerRadius x:Key="Shape.Chip">0</CornerRadius>

    <Style x:Key="PanelFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.Panel}" />
    </Style>

    <Style x:Key="CenterSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ===== Page header: no gradient, no shadow; an ink rule, and a title that wraps rather than being cut ===== -->

    <Style x:Key="HeaderBandStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0,0,0,6" />
        <Setter Property="Padding" Value="24,24,24,22" />
    </Style>

    <Style x:Key="HeaderCoverStyle" TargetType="Grid" />

    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Hero}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Margin" Value="0,4,0,10" />
    </Style>

    <!-- ===== Headings: set big, ruled in ink ===== -->

    <Style x:Key="SectionTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,30,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0,0,0,4" Padding="0,0,0,6">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.Text.Title}" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,6,0,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <Rectangle Width="72" Height="10" HorizontalAlignment="Left" Margin="0,0,0,12" Fill="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.Text.Hero}" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap" LineHeight="54" LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons: solid rectangles that swap colours when pressed on ===== -->

    <Style x:Key="BigPlay" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Content" Value="&#xE768;" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayBubble" TargetType="Button" BasedOn="{StaticResource BigPlay}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillOutline" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Filters read as tabs with a thick bar under the one that is on -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Small}" />
        <Setter Property="Margin" Value="0,0,16,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="0,0,0,4" Padding="0,2,0,3" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Body}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,4" BorderBrush="{DynamicResource Brush.TextPrimary}">
                        <Grid Margin="2,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.TextMuted}"
                                       VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menu: big type on the colour field, inverted under the pointer ===== -->

    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Track rows: tall, numbered in display type, inverted under the pointer or when selected ===== -->

    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type m:TrackRow}">
        <Border x:Name="Row" Height="60" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Num" Text="{Binding Number}" FontFamily="{DynamicResource Font.Display}" FontWeight="ExtraBold" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.55" />
                <TextBlock x:Name="Eq" Style="{StaticResource GlyphText}" Text="&#xE995;" Foreground="{DynamicResource Brush.Accent}"
                           HorizontalAlignment="Left" Margin="10,0,0,0" FontSize="18" Visibility="Collapsed" />
                <ContentControl Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Focusable="False"
                                ContentTemplate="{DynamicResource TrackCover}" Content="{Binding}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                    <TextBlock x:Name="TitleText" Text="{Binding Track.Title}" FontFamily="{DynamicResource Font.Display}" FontWeight="SemiBold"
                               FontSize="{DynamicResource Size.Text.Large}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Track.Artist}" FontSize="{DynamicResource Size.Text.Small}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Track.Album}" FontSize="{DynamicResource Size.Text.Small}" Opacity="0.7"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <Button x:Name="Heart" Grid.Column="4" Style="{DynamicResource IconButton}" Content="&#xEB51;" Opacity="0"
                        Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Track}" ToolTip="{loc:T common.add_to_liked_songs}" />
                <TextBlock Grid.Column="5" Text="{Binding Track.DurationText}" FontFamily="{DynamicResource Font.Numbers}" FontSize="{DynamicResource Size.Text.Small}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Opacity="0.7" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource Brush.Surface}" />
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
                <Setter TargetName="Heart" Property="Foreground" Value="{DynamicResource Brush.Surface}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource Brush.Surface}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsLiked}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
                <Setter TargetName="Heart" Property="Content" Value="&#xEB52;" />
            </DataTrigger>
            <!-- The playing track: its number gives way to the equalizer, its title takes the accent unless the row is inverted -->
            <DataTrigger Binding="{Binding Track.IsCurrent}" Value="True">
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Track.IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TrackHeaderTemplate">
        <Border BorderBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0,0,0,3" Padding="0,0,8,6"
                TextElement.Foreground="{DynamicResource Brush.TextPrimary}" TextElement.FontSize="{DynamicResource Size.Text.Small}"
                TextElement.FontFamily="{DynamicResource Font.Display}" TextElement.FontWeight="SemiBold">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                    <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" HorizontalAlignment="Left" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="{loc:T common.title}" Margin="12,0,0,0" />
                <TextBlock Grid.Column="3" Text="{loc:T common.album}" />
                <TextBlock Grid.Column="5" Text="&#xE823;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===== Cards: a square cover and a title in display type; the whole card inverts under the pointer ===== -->

    <Style x:Key="PosterCard" TargetType="Button">
        <Setter Property="v:Motion.HoverLift" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosterTitle" TargetType="TextBlock" BasedOn="{StaticResource PlayingText}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Large}" />
        <Setter Property="Margin" Value="0,10,0,2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <DataTemplate x:Key="AlbumCard" DataType="{x:Type m:Album}">
        <Button Style="{StaticResource PosterCard}"
                Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Tag>
                <MultiBinding Converter="{StaticResource PlayingContext}">
                    <Binding />
                    <Binding Path="DataContext.Player.ContextUri" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.ContextName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.HasTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.Current" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Button.Tag>
            <StackPanel Width="{DynamicResource Size.Card}">
                <Grid Width="{DynamicResource Size.Card}" Height="{DynamicResource Size.Card}">
                    <Border Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE93C;" FontSize="44" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtPath, Converter={StaticResource Art}, ConverterParameter=card}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ContentControl ContentTemplate="{DynamicResource PlayingBadge}" Content="{Binding}" />
                    <Button Style="{DynamicResource PlayBubble}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PosterTitle}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Size.Text.Small}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="ArtistCard" DataType="{x:Type m:Artist}">
        <Button Style="{StaticResource PosterCard}"
                Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Tag>
                <MultiBinding Converter="{StaticResource PlayingContext}">
                    <Binding />
                    <Binding Path="DataContext.Player.ContextUri" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.ContextName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.HasTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.Current" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Button.Tag>
            <StackPanel Width="{DynamicResource Size.Card}">
                <Grid Width="{DynamicResource Size.Card}" Height="{DynamicResource Size.Card}">
                    <Border Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE77B;" FontSize="44" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtPath, Converter={StaticResource Art}, ConverterParameter=card}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ContentControl ContentTemplate="{DynamicResource PlayingBadge}" Content="{Binding}" />
                    <Button Style="{DynamicResource PlayBubble}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding DataContext.PlayArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Name}" Style="{StaticResource PosterTitle}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Size.Text.Small}" Opacity="0.7" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistCard" DataType="{x:Type m:SpotifyPlaylist}">
        <Button Style="{StaticResource PosterCard}"
                Command="{Binding DataContext.OpenSpotifyPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Tag>
                <MultiBinding Converter="{StaticResource PlayingContext}">
                    <Binding />
                    <Binding Path="DataContext.Player.ContextUri" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.ContextName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.HasTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="DataContext.Player.Current" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Button.Tag>
            <StackPanel Width="{DynamicResource Size.Card}">
                <Grid Width="{DynamicResource Size.Card}" Height="{DynamicResource Size.Card}">
                    <Border Background="{DynamicResource Brush.Hover}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FD;" FontSize="44" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtPath, Converter={StaticResource Art}, ConverterParameter=card}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <ContentControl ContentTemplate="{DynamicResource PlayingBadge}" Content="{Binding}" />
                    <Button Style="{DynamicResource PlayBubble}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding DataContext.PlaySpotifyPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Name}" Style="{StaticResource PosterTitle}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Size.Text.Small}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

</ResourceDictionary>
