<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Sonora.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Sonora.Models"
                    xmlns:v="clr-namespace:Sonora.Views">

    <!-- "Soul": a 1970s record sleeve. Warm earth and sun colours, a soft heavy serif, and corners cut like a leaf
         (two opposite corners round, the other two nearly square) on every panel, card and control. -->

    <CornerRadius x:Key="Shape.Icon">18,5,18,5</CornerRadius>
    <CornerRadius x:Key="Shape.Nav">16,4,16,4</CornerRadius>
    <CornerRadius x:Key="Shape.Play">18,5,18,5</CornerRadius>
    <CornerRadius x:Key="Shape.Big">30,7,30,7</CornerRadius>
    <CornerRadius x:Key="Shape.Pill">22,5,22,5</CornerRadius>
    <CornerRadius x:Key="Shape.Chip">16,4,16,4</CornerRadius>

    <Style x:Key="PanelFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="40,9,40,9" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.Panel}" />
    </Style>

    <Style x:Key="CenterSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="40,9,40,9" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ===== Page header: a warm band, cut like the panels ===== -->

    <Style x:Key="HeaderBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.HeaderGradient}" />
        <Setter Property="CornerRadius" Value="30,8,30,8" />
        <Setter Property="Margin" Value="16,16,16,0" />
        <Setter Property="Padding" Value="26,22,26,22" />
    </Style>

    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Hero}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="54" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Margin" Value="0,2,0,8" />
    </Style>

    <!-- ===== Headings: the sleeve's serif, and three stripes under a page title ===== -->

    <Style x:Key="SectionTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,28,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                               FontSize="{DynamicResource Size.Text.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleBox" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,8,0,22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.Text.Hero}" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Left" Width="120">
                            <Rectangle Height="6" Fill="{DynamicResource Brush.Accent}" />
                            <Rectangle Height="6" Margin="0,3,0,0" Fill="{DynamicResource Brush.Accent}" Opacity="0.62" />
                            <Rectangle Height="6" Margin="0,3,0,0" Fill="{DynamicResource Brush.Accent}" Opacity="0.3" />
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Controls ===== -->

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Body}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="22,5,22,5" BorderThickness="2" BorderBrush="Transparent">
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.TextMuted}"
                                       VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="18,5,18,5">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards: leaf-cut tiles, titles in the serif ===== -->

    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="30,7,30,7" Padding="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PlayingText}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Text.Large}" />
        <Setter Property="Margin" Value="0,10,0,2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== Track rows: the serif for numbers and titles ===== -->

    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type m:TrackRow}">
        <Grid Height="{DynamicResource Size.Row}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NumberWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding ArtWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="{Binding AlbumWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding LikeWidth, Source={x:Static v:ColumnLayout.Current}}" />
                <ColumnDefinition Width="{Binding DurationWidth, Source={x:Static v:ColumnLayout.Current}}" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource Brush.TextMuted}" FontFamily="{DynamicResource Font.Display}"
                       FontWeight="SemiBold" FontSize="{DynamicResource Size.Text.Large}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="Eq" Style="{StaticResource GlyphText}" Text="&#xE995;" Foreground="{DynamicResource Brush.Accent}"
                       HorizontalAlignment="Right" Margin="0,0,12,0" Visibility="Collapsed" />
            <ContentControl Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" ContentTemplate="{DynamicResource TrackCover}" Content="{Binding}" Focusable="False" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                <TextBlock x:Name="TitleText" Text="{Binding Track.Title}" FontSize="{DynamicResource Size.Text.Large}" FontFamily="{DynamicResource Font.Display}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Track.Artist}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Track.Album}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Size.Text.Small}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <Button x:Name="Heart" Grid.Column="4" Style="{DynamicResource IconButton}" Content="&#xEB51;" Opacity="0"
                    Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Track}" ToolTip="{loc:T common.add_to_liked_songs}" />
            <TextBlock Grid.Column="5" Text="{Binding Track.DurationText}" Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Numbers}"
                       FontSize="{DynamicResource Size.Text.Small}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsLiked}" Value="True">
                <Setter TargetName="Heart" Property="Opacity" Value="1" />
                <Setter TargetName="Heart" Property="Content" Value="&#xEB52;" />
                <Setter TargetName="Heart" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Heart" Property="ToolTip" Value="Retirer des Titres likés" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsCurrent}" Value="True">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
